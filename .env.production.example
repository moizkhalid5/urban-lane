# ──────────────────────────────────────────────────────────────────────────
# Urban Lane — PRODUCTION environment (Hostinger Node.js Web Apps hosting)
#
# Do NOT commit real secrets. On Hostinger you don't upload this file —
# copy each NAME/VALUE into hPanel → your Node.js app → Environment variables.
# This file documents exactly which variables the app needs in production.
# ──────────────────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV="production"
# Your live site URL (used for SEO, sitemap, robots, email links). HTTPS.
APP_URL="https://your-domain.com"

# ---- Database: Hostinger MySQL ----
# hPanel → Databases → MySQL Databases. Create a DB + user, then build the URL:
#   mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# DB_HOST is usually "localhost" when the DB and the Node app are on the same
# Hostinger account. URL-encode any special characters in the password
# (e.g. @ -> %40, # -> %23).
DATABASE_URL="mysql://u123456_urban:CHANGE_ME@localhost:3306/u123456_urban"

# ---- Auth.js / NextAuth v5 ----
# Generate once locally:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Must match your real HTTPS domain exactly.
NEXTAUTH_URL="https://your-domain.com"
AUTH_URL="https://your-domain.com"
AUTH_SESSION_MAX_AGE_DAYS="30"

# ---- Object storage: local, inside the website directory ----
# Images are stored on the server's own disk under <app>/public/uploads and
# served at /uploads/*. This keeps storage inside the website directory (no
# external S3/Cloudinary needed). Leave UPLOAD_DIR unset to use the default.
IMAGE_STORAGE="local"
# UPLOAD_DIR="public/uploads"   # optional override; must be served at /uploads/*

# ---- Default admin (only used by the one-time seed) ----
SEED_ADMIN_EMAIL="admin@your-domain.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_Strong!123"
SEED_ADMIN_NAME="Store Admin"

# ---- Email (transactional) ----
# "console" just logs; switch to "smtp" or "resend" for real order/contact mail.
EMAIL_PROVIDER="console"
EMAIL_FROM="Urban Lane <no-reply@your-domain.com>"
STORE_NOTIFICATIONS_EMAIL="orders@your-domain.com"
# Resend
RESEND_API_KEY=""
# SMTP (Hostinger Email / Titan also work here)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ---- Currency ----
BASE_CURRENCY="PKR"

# ---- Payments (add keys only when you enable a gateway) ----
# Works out of the box: Cash on Delivery + Bank Transfer.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="live"
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_ENV="production"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
