# ──────────────────────────────────────────────────────────────────────────
# Urbane Lane — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# ---- App ----
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (MySQL / MariaDB) ----
# Matches docker-compose.yml. On Hostinger, use the MySQL details from hPanel:
# mysql://DBUSER:DBPASS@DBHOST:3306/DBNAME
DATABASE_URL="mysql://urbane:urbane@localhost:3306/urbane_lane"

# ---- Auth.js / NextAuth v5 ----
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Session lifetime in days
AUTH_SESSION_MAX_AGE_DAYS="30"

# ---- Default admin (used by the seed script) ----
SEED_ADMIN_EMAIL="admin@urbanelane.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Store Admin"

# ---- Email (transactional) ----
# EMAIL_PROVIDER: "console" (dev, logs to terminal) | "resend" | "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="Urbane Lane <no-reply@urbanelane.com>"
# Address that receives store notifications (orders, contact, refunds)
STORE_NOTIFICATIONS_EMAIL="orders@urbanelane.com"
# Resend
RESEND_API_KEY=""
# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ---- Image storage ----
# IMAGE_STORAGE: "local" (dev, /public/uploads) | "cloudinary" | "s3" | "r2"
IMAGE_STORAGE="local"
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# S3 / R2 (S3-compatible)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Payments (abstraction; add real keys when integrating) ----
# Live methods out of the box: "cod" (cash on delivery), "bank_transfer".
# Card gateways are placeholders until keys are added.
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
# Safepay (Pakistan)
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_ENV="sandbox"
# PayFast (Pakistan)
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""

# ---- Currency ----
# Base currency that all prices are stored in.
BASE_CURRENCY="PKR"
