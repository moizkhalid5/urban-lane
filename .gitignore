# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (keep .env.example tracked)
.env
.env*.local
.env.development
.env.production

# database
/prisma/*.db
/prisma/*.db-journal

# uploads (local dev image storage)
# Runtime/admin-uploaded files in /public/uploads stay out of git, BUT the seed
# catalogue images under /products are committed so they deploy with the code.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/products/
!/public/uploads/products/**

# deploy bundles (regenerate as needed)
/uploads-bundle.zip
/code-bundle.zip
/db-bundle.sql

# source assets kept locally only (NOT for the repo)
/*.docx
/*.pdf
/*.xlsx
/~$*
/White background images-*/
/Urbanlane stock images-*/
/_deploy_stage/

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea

# Raw image drops, design originals and import reports: only the optimised copies in /public deploy
/Urbanlane White background images-*/
/Banners/
/shop by brand/
/category photos/
/*.csv
/*.zip
/brand logos/
